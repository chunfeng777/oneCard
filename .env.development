## 开发环境
NODE_ENV='development'

# 应用端口
VITE_APP_PORT = 3000

# 代理前缀
VITE_APP_BASE_API = '/dev-api'

# 开发接口地址
# VITE_APP_API_URL = http://192.168.10.187:8989
VITE_APP_API_URL = http://192.168.1.42:8989
# VITE_APP_API_URL = http://172.104.164.82:8989

# WebSocket 端点（不配置则关闭）
VITE_APP_WS_ENDPOINT=http://192.168.1.42:8989/ws
# VITE_APP_WS_ENDPOINT=https://apply.bycloudx.com/ws


# 是否启用 Mock 服务
VITE_MOCK_DEV_SERVER = false
